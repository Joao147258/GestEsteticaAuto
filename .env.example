# ============================================================
# GestEsteticaAuto — modelo de variáveis de ambiente
# Copie para .env e preencha com os valores reais.
# ============================================================

# Conexão com o PostgreSQL (Prisma 7 + @prisma/adapter-pg)
DATABASE_URL="postgres://user:password@host:5432/database"

# Origens permitidas no CORS (separadas por vírgula). Sem esta variável,
# a API libera apenas localhost:3000 e localhost:3001 (desenvolvimento).
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
