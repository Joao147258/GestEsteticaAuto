# ============================================================
# GestEsteticaAuto — modelo de variáveis de ambiente
# Copie para .env e preencha com os valores reais.
# ============================================================

# Conexão com o PostgreSQL (Prisma 7 + @prisma/adapter-pg)
DATABASE_URL="postgres://user:password@host:5432/database"

# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Autenticação JWT
JWT_SECRET=change_me_super_secret_key_v1
JWT_EXPIRES_IN=1d

# Credenciais de Seed Inicial (placeholders)
SEED_USER_JOAO=
SEED_PASSWORD_JOAO=
SEED_USER_VINICIUS=
SEED_PASSWORD_VINICIUS=
