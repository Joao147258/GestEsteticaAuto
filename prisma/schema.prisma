enum TipoPessoa {
  PESSOA_FISICA
  PESSOA_JURIDICA
}

enum TipoContato {
  TELEFONE
  CELULAR
  WHATSAPP
  EMAIL
  OUTRO
}

enum TipoParcela {
  SINAL
  PARCELA
}

enum TipoFormaPagamento {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  BOLETO
  TRANSFERENCIA
  OUTRO
}
