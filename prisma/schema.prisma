// ============================================================================
// GestEsteticaAuto — Schema Prisma 7 (PostgreSQL)
// ============================================================================
// Convenções:
//  - `Negocio` é o tenant (preparação para SaaS). Entidades "raiz" recebem
//    `negocioId`; entidades filhas herdam o escopo via relação com a raiz.
//  - Status são armazenados como `String` (valores definidos no domínio,
//    em src/Domain/**/*_types.ts). Enums do Prisma só onde o conjunto de
//    valores é estável e útil para integridade da persistência.
//  - Timestamps: `criadoEm` e `atualizadoEm` (@updatedAt).
//  - IDs: `cuid()` como default.
//  - Valores monetários: `Decimal` com `@db.Decimal(10, 2)`.
//  - Snapshots comerciais: itens de orçamento/OS preservam descricao,
//    quantidade, valorUnitario e desconto (não dependem do catálogo atual).
//
// A URL de conexão fica em `prisma.config.ts` (requisito do Prisma 7),
// NÃO aqui no datasource.
// ============================================================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// NEGÓCIO (tenant)
// ============================================================================

model Negocio {
  id           String   @id @default(cuid())
  nome         String
  cnpj         String?  @unique
  telefone     String?
  email        String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuarios                    Usuario[]
  clientes                    Cliente[]
  veiculos                    Veiculo[]
  origensCliente              OrigemCliente[]
  tagsCliente                 TagCliente[]
  categoriasServico           CategoriaServico[]
  servicos                    Servico[]
  categoriasProduto           CategoriaProduto[]
  produtos                    Produto[]
  pacotesServico              PacoteServico[]
  tabelasPreco                TabelaPreco[]
  orcamentos                  Orcamento[]
  politicasComerciais         PoliticaComercial[]
  condicoesComerciais         CondicaoComercial[]
  aceitesOrcamento            AceiteOrcamento[]
  ordensServico               OrdemServico[]
  agendas                     Agenda[]
  agendamentos                Agendamento[]
  titulos                     Titulo[]
  formasPagamento             FormaPagamento[]
  estoquesVenda               EstoqueVenda[]
  estoquesInterno             EstoqueInterno[]
  consumosInsumo              ConsumoInsumoServico[]
  movimentacoesEstoqueInterno MovimentacaoEstoqueInterno[]
  itemOrdemServicos           ItemOrdemServico[]
  pagamentos                  Pagamento[]
  auditorias                  Auditoria[]
  anexos                      Anexo[]
  itemOrcamentos              ItemOrcamento[]
}

model Usuario {
  id           String   @id @default(cuid())
  negocioId    String
  nome         String
  email        String
  senhaHash    String
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  negocio    Negocio     @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  auditorias Auditoria[]

  @@unique([negocioId, email])
  @@index([negocioId])
}

// ============================================================================
// CLIENTES
// ============================================================================

model Cliente {
  id           String     @id @default(cuid())
  negocioId    String
  nome         String
  tipoPessoa   TipoPessoa @default(PESSOA_FISICA)
  cpfCnpj      String?
  email        String?
  telefone     String?
  status       String     @default("ATIVO")
  observacoes  String?
  origemId     String?
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt

  negocio          Negocio              @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  origem           OrigemCliente?       @relation(fields: [origemId], references: [id], onDelete: SetNull)
  contatos         Contato[]
  enderecos        Endereco[]
  preferencias     PreferenciaCliente[]
  tags             TagCliente[]
  anexos           AnexoCliente[]
  veiculos         Veiculo[]
  orcamentos       Orcamento[]
  ordensServico    OrdemServico[]
  agendamentos     Agendamento[]
  titulos          Titulo[]
  aceitesOrcamento AceiteOrcamento[]

  @@index([negocioId])
  @@index([negocioId, status])
}

model Contato {
  id        String      @id @default(cuid())
  clienteId String
  tipo      TipoContato
  valor     String
  principal Boolean     @default(false)
  criadoEm  DateTime    @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}

model Endereco {
  id          String   @id @default(cuid())
  clienteId   String
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?
  principal   Boolean  @default(false)
  criadoEm    DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}

model PreferenciaCliente {
  id        String   @id @default(cuid())
  clienteId String
  chave     String
  valor     String
  criadoEm  DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, chave])
  @@index([clienteId])
}

model TagCliente {
  id        String   @id @default(cuid())
  negocioId String
  nome      String
  cor       String?
  criadoEm  DateTime @default(now())

  negocio  Negocio   @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  clientes Cliente[]

  @@unique([negocioId, nome])
  @@index([negocioId])
}

model OrigemCliente {
  id        String   @id @default(cuid())
  negocioId String
  nome      String
  criadoEm  DateTime @default(now())

  negocio  Negocio   @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  clientes Cliente[]

  @@index([negocioId])
}

model AnexoCliente {
  id        String   @id @default(cuid())
  clienteId String
  anexoId   String
  criadoEm  DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  anexo   Anexo   @relation(fields: [anexoId], references: [id], onDelete: Cascade)

  @@unique([clienteId, anexoId])
  @@index([clienteId])
  @@index([anexoId])
}

// ============================================================================
// VEÍCULOS
// ============================================================================

model Veiculo {
  id            String   @id @default(cuid())
  negocioId     String
  clienteId     String
  placa         String?
  marca         String?
  modelo        String?
  anoFabricacao Int?
  anoModelo     Int?
  cor           String?
  chassi        String?
  renavam       String?
  quilometragem Int?
  observacoes   String?
  status        String   @default("ATIVO")
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  negocio               Negocio               @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  cliente               Cliente               @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  orcamentos            Orcamento[]
  ordensServico         OrdemServico[]
  agendamentos          Agendamento[]
  registrosFotograficos RegistroFotografico[]

  @@index([negocioId])
  @@index([clienteId])
}

// ============================================================================
// CATÁLOGO
// ============================================================================

model CategoriaServico {
  id           String   @id @default(cuid())
  negocioId    String
  nome         String
  descricao    String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  negocio  Negocio   @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  servicos Servico[]

  @@index([negocioId])
}

model Servico {
  id                 String   @id @default(cuid())
  negocioId          String
  categoriaServicoId String?
  nome               String
  descricao          String?
  precoBase          Decimal? @db.Decimal(10, 2)
  duracaoMinutos     Int?
  observacoes        String?
  status             String   @default("ATIVO")
  criadoEm           DateTime @default(now())
  atualizadoEm       DateTime @updatedAt

  negocio           Negocio                @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  categoria         CategoriaServico?      @relation(fields: [categoriaServicoId], references: [id], onDelete: SetNull)
  itensOrcamento    ItemOrcamento[]
  itensOrdemServico ItemOrdemServico[]
  pacotes           PacoteServico[]
  consumosInsumo    ConsumoInsumoServico[]

  @@index([negocioId])
  @@index([categoriaServicoId])
}

model CategoriaProduto {
  id           String   @id @default(cuid())
  negocioId    String
  nome         String
  descricao    String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  negocio  Negocio   @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  produtos Produto[]

  @@index([negocioId])
}

model Produto {
  id                 String   @id @default(cuid())
  negocioId          String
  categoriaProdutoId String?
  nome               String
  descricao          String?
  // Campos do domínio (ProdutoProps): tipoUso e unidadeMedida são
  // obrigatórios; custo/preço sugerido e observações são opcionais.
  tipoUso            String   @default("INSUMO_INTERNO")
  unidadeMedida      String   @default("UNIDADE")
  custoReferencia    Decimal? @db.Decimal(10, 2)
  precoVendaSugerido Decimal? @db.Decimal(10, 2)
  observacoes        String?
  // Campos legados (não usados pelo domínio na V1, mantidos por segurança):
  // preco (preço simples, sem conceito no Domain), codigoBarras e
  // estoqueMinimo (o mínimo de estoque pertence a EstoqueInterno).
  preco              Decimal? @db.Decimal(10, 2)
  codigoBarras       String?
  estoqueMinimo      Int?
  status             String   @default("ATIVO")
  criadoEm           DateTime @default(now())
  atualizadoEm       DateTime @updatedAt

  negocio                     Negocio                      @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  categoria                   CategoriaProduto?            @relation(fields: [categoriaProdutoId], references: [id], onDelete: SetNull)
  itensOrcamento              ItemOrcamento[]
  itensOrdemServico           ItemOrdemServico[]
  estoquesVenda               EstoqueVenda[]
  estoquesInterno             EstoqueInterno[]
  consumosInsumo              ConsumoInsumoServico[]
  movimentacoesEstoqueInterno MovimentacaoEstoqueInterno[]

  @@index([negocioId])
  @@index([categoriaProdutoId])
}

// ConsumoInsumoServico — quanto de um insumo (produto) um serviço consome por
// execução. Mapeia a entidade ConsumoInsumoServico do Domain. A unicidade
// (negocioId, servicoId, produtoId) evita configurar o mesmo insumo duas
// vezes para o mesmo serviço (pendência de backlog resolvida).
model ConsumoInsumoServico {
  id            String   @id @default(cuid())
  negocioId     String
  servicoId     String
  produtoId     String
  quantidade    Decimal  @db.Decimal(10, 3)
  unidadeMedida String
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  negocio Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  servico Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([negocioId, servicoId, produtoId])
  @@index([negocioId])
  @@index([servicoId])
  @@index([produtoId])
}

model PacoteServico {
  id           String   @id @default(cuid())
  negocioId    String
  nome         String
  descricao    String?
  preco        Decimal? @db.Decimal(10, 2)
  status       String   @default("ATIVO")
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  negocio  Negocio   @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  servicos Servico[]

  @@index([negocioId])
}

model TabelaPreco {
  id             String    @id @default(cuid())
  negocioId      String
  nome           String
  descricao      String?
  vigenciaInicio DateTime?
  vigenciaFim    DateTime?
  status         String    @default("ATIVA")
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  negocio Negocio @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@index([negocioId])
}

// ============================================================================
// COMERCIAL
// ============================================================================

model Orcamento {
  id                  String    @id @default(cuid())
  negocioId           String
  clienteId           String
  veiculoId           String?
  numero              String?
  politicaComercialId String?
  condicaoComercialId String?
  status              String    @default("RASCUNHO")
  observacoes         String?
  subtotal            Decimal   @default(0) @db.Decimal(10, 2)
  valorDesconto       Decimal   @default(0) @db.Decimal(10, 2)
  valorAcrescimo      Decimal   @default(0) @db.Decimal(10, 2)
  valorTotal          Decimal   @default(0) @db.Decimal(10, 2)
  validoAte           DateTime?
  validadeDias        Int?
  criadoEm            DateTime  @default(now())
  atualizadoEm        DateTime  @updatedAt

  negocio      Negocio            @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  cliente      Cliente            @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  veiculo      Veiculo?           @relation(fields: [veiculoId], references: [id], onDelete: SetNull)
  politica     PoliticaComercial? @relation(fields: [politicaComercialId], references: [id], onDelete: SetNull)
  condicao     CondicaoComercial? @relation(fields: [condicaoComercialId], references: [id], onDelete: SetNull)
  itens        ItemOrcamento[]
  aceites      AceiteOrcamento[]
  ordemServico OrdemServico?

  @@index([negocioId])
  @@index([clienteId])
  @@index([veiculoId])
  @@index([politicaComercialId])
  @@index([condicaoComercialId])
  @@index([negocioId, status])
}

model ItemOrcamento {
  id            String   @id @default(cuid())
  negocioId     String
  orcamentoId   String
  servicoId     String?
  produtoId     String?
  tipo          String   @default("SERVICO")
  descricao     String?
  quantidade    Decimal  @default(1) @db.Decimal(10, 3)
  valorUnitario Decimal  @db.Decimal(10, 2)
  valorTotal    Decimal  @default(0) @db.Decimal(10, 2)
  desconto      Decimal? @db.Decimal(10, 2)
  observacoes   String?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  negocio   Negocio   @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  servico   Servico?  @relation(fields: [servicoId], references: [id], onDelete: SetNull)
  produto   Produto?  @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  @@index([negocioId])
  @@index([orcamentoId])
  @@index([servicoId])
  @@index([produtoId])
}

model AceiteOrcamento {
  id           String    @id @default(cuid())
  negocioId    String
  orcamentoId  String
  clienteId    String
  status       String    @default("PENDENTE")
  canal        String?
  assinatura   String?
  aceitoEm     DateTime?
  recusadoEm   DateTime?
  observacoes  String?
  enviadoEm    DateTime?
  expiradoEm   DateTime?
  ip           String?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  negocio   Negocio   @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  cliente   Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([negocioId])
  @@index([orcamentoId])
  @@index([clienteId])
}

model PoliticaComercial {
  id           String   @id @default(cuid())
  negocioId    String
  nome         String
  descricao    String?
  regras       Json?
  status       String   @default("ATIVA")
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  negocio    Negocio     @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  orcamentos Orcamento[]

  @@index([negocioId])
}

model CondicaoComercial {
  id            String   @id @default(cuid())
  negocioId     String
  nome          String
  descricao     String?
  tipoDesconto  String?
  valorDesconto Decimal? @db.Decimal(10, 2)
  status        String   @default("ATIVA")
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  negocio    Negocio     @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  orcamentos Orcamento[]

  @@index([negocioId])
}

// ============================================================================
// OPERAÇÃO
// ============================================================================

model OrdemServico {
  id                String    @id @default(cuid())
  negocioId         String
  clienteId         String
  veiculoId         String
  orcamentoId       String?   @unique
  agendamentoId     String?
  numero            String?
  responsavelId     String?
  status            String    @default("ABERTA")
  observacoes       String?
  abertaEm          DateTime  @default(now())
  iniciadaEm        DateTime?
  pausadaEm         DateTime?
  finalizadaEm      DateTime?
  canceladaEm       DateTime?
  previsaoInicio    DateTime?
  previsaoConclusao DateTime?
  // Campos legados (não usados pelo domínio na V1, mantidos por segurança):
  // dataInicio e dataFim eram o controle de datas antes dos timestamps
  // específicos (abertaEm/iniciadaEm/finalizadaEm).
  dataInicio        DateTime?
  dataFim           DateTime?
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  negocio               Negocio               @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  cliente               Cliente               @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  veiculo               Veiculo               @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  orcamento             Orcamento?            @relation(fields: [orcamentoId], references: [id], onDelete: SetNull)
  itens                 ItemOrdemServico[]
  inspecaoEntrada       InspecaoEntrada?
  registrosFotograficos RegistroFotografico[]
  observacoesTecnicas   ObservacaoTecnica[]

  @@index([negocioId])
  @@index([clienteId])
  @@index([veiculoId])
  @@index([orcamentoId])
  @@index([negocioId, status])
}

model ItemOrdemServico {
  id             String    @id @default(cuid())
  negocioId      String
  ordemServicoId String
  servicoId      String?
  descricao      String?
  responsavelId  String?
  status         String    @default("PENDENTE")
  iniciadoEm     DateTime?
  finalizadoEm   DateTime?
  observacoes    String?
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt
  // Campos legados (não usados pelo domínio na V1, mantidos por segurança):
  // produtoId, quantidade, valorUnitario e desconto eram uma visão comercial
  // do item; o domínio da operação trata o item apenas como execução.
  produtoId      String?
  quantidade     Int       @default(1)
  valorUnitario  Decimal?  @db.Decimal(10, 2)
  desconto       Decimal?  @db.Decimal(10, 2)

  negocio      Negocio      @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  ordemServico OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  servico      Servico?     @relation(fields: [servicoId], references: [id], onDelete: SetNull)
  produto      Produto?     @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  @@index([negocioId])
  @@index([ordemServicoId])
  @@index([servicoId])
  @@index([produtoId])
}

model InspecaoEntrada {
  id             String    @id @default(cuid())
  ordemServicoId String    @unique
  realizadoEm    DateTime?
  observacoes    String?
  criadoEm       DateTime  @default(now())

  ordemServico OrdemServico       @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  checklists   ChecklistVeiculo[]

  @@index([ordemServicoId])
}

model ChecklistVeiculo {
  id                String  @id @default(cuid())
  inspecaoEntradaId String
  item              String
  estado            String  @default("NAO_VERIFICADO")
  verificado        Boolean @default(false)
  observacao        String?
  confirmacao       String?

  inspecaoEntrada InspecaoEntrada @relation(fields: [inspecaoEntradaId], references: [id], onDelete: Cascade)

  @@index([inspecaoEntradaId])
}

model RegistroFotografico {
  id             String   @id @default(cuid())
  ordemServicoId String?
  veiculoId      String?
  anexoId        String
  descricao      String?
  criadoEm       DateTime @default(now())

  ordemServico OrdemServico? @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  veiculo      Veiculo?      @relation(fields: [veiculoId], references: [id], onDelete: Cascade)
  anexo        Anexo         @relation(fields: [anexoId], references: [id], onDelete: Cascade)

  @@index([ordemServicoId])
  @@index([veiculoId])
  @@index([anexoId])
}

model Agenda {
  id           String   @id @default(cuid())
  negocioId    String
  nome         String
  descricao    String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  negocio      Negocio       @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  agendamentos Agendamento[]

  @@index([negocioId])
}

model Agendamento {
  id             String    @id @default(cuid())
  negocioId      String
  agendaId       String?
  clienteId      String?
  veiculoId      String?
  dataHoraInicio DateTime
  dataHoraFim    DateTime?
  status         String    @default("AGENDADO")
  observacoes    String?
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  negocio Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  agenda  Agenda?  @relation(fields: [agendaId], references: [id], onDelete: SetNull)
  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  veiculo Veiculo? @relation(fields: [veiculoId], references: [id], onDelete: SetNull)

  @@index([negocioId])
  @@index([agendaId])
  @@index([clienteId])
  @@index([veiculoId])
  @@index([dataHoraInicio])
}

model ObservacaoTecnica {
  id             String   @id @default(cuid())
  ordemServicoId String
  texto          String
  criadoEm       DateTime @default(now())

  ordemServico OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)

  @@index([ordemServicoId])
}

// ============================================================================
// FINANCEIRO
// ============================================================================

model FormaPagamento {
  id                     String              @id @default(cuid())
  negocioId              String
  nome                   String
  tipo                   TipoFormaPagamento?
  exigeConfirmacaoManual Boolean             @default(false)
  status                 String              @default("ATIVA")
  criadoEm               DateTime            @default(now())
  atualizadoEm           DateTime            @updatedAt

  negocio    Negocio     @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  pagamentos Pagamento[]

  @@index([negocioId])
}

model Titulo {
  id                 String    @id @default(cuid())
  negocioId          String
  origem             String
  origemId           String?
  clienteId          String?
  fornecedorId       String?
  descricao          String
  valorOriginal      Decimal   @db.Decimal(10, 2)
  valorDesconto      Decimal   @default(0) @db.Decimal(10, 2)
  valorAcrescimo     Decimal   @default(0) @db.Decimal(10, 2)
  status             String    @default("ABERTO")
  dataEmissao        DateTime  @default(now())
  dataVencimento     DateTime?
  observacoes        String?
  canceladoEm        DateTime?
  motivoCancelamento String?
  criadoEm           DateTime  @default(now())
  atualizadoEm       DateTime  @updatedAt

  negocio    Negocio                    @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  cliente    Cliente?                   @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  parcelas   Parcela[]
  pagamentos Pagamento[]
  alteracoes TituloAlteracaoHistorico[]

  @@index([negocioId])
  @@index([clienteId])
  @@index([status])
  @@index([origem, origemId])
}

model Parcela {
  id             String      @id @default(cuid())
  tituloId       String
  numero         Int
  tipo           TipoParcela @default(PARCELA)
  descricao      String?
  valorOriginal  Decimal     @db.Decimal(10, 2)
  status         String      @default("PENDENTE")
  dataVencimento DateTime?
  criadoEm       DateTime    @default(now())
  atualizadoEm   DateTime    @updatedAt

  titulo     Titulo      @relation(fields: [tituloId], references: [id], onDelete: Cascade)
  pagamentos Pagamento[]

  @@unique([tituloId, numero])
  @@index([tituloId])
}

model Pagamento {
  id                      String    @id @default(cuid())
  negocioId               String
  tituloId                String
  parcelaId               String
  formaPagamentoId        String
  formaPagamentoDescricao String
  valor                   Decimal   @db.Decimal(10, 2)
  status                  String    @default("PENDENTE")
  dataPagamento           DateTime  @default(now())
  confirmadoEm            DateTime?
  canceladoEm             DateTime?
  motivoCancelamento      String?
  observacoes             String?
  criadoEm                DateTime  @default(now())

  titulo         Titulo         @relation(fields: [tituloId], references: [id], onDelete: Cascade)
  parcela        Parcela        @relation(fields: [parcelaId], references: [id], onDelete: Cascade)
  formaPagamento FormaPagamento @relation(fields: [formaPagamentoId], references: [id], onDelete: Restrict)
  negocio        Negocio        @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@index([negocioId])
  @@index([tituloId])
  @@index([parcelaId])
  @@index([formaPagamentoId])
}

model TituloAlteracaoHistorico {
  id        String   @id @default(cuid())
  tituloId  String
  tipo      String
  descricao String
  autorId   String?
  data      DateTime @default(now())

  titulo Titulo @relation(fields: [tituloId], references: [id], onDelete: Cascade)

  @@index([tituloId])
  @@index([tipo])
}

// ============================================================================
// ESTOQUE
// ============================================================================

model EstoqueVenda {
  id                  String   @id @default(cuid())
  negocioId           String
  produtoId           String
  quantidadeAtual     Int      @default(0)
  quantidadeReservada Int      @default(0)
  unidadeMedida       String   @default("UNIDADE")
  custoUnitario       Decimal? @db.Decimal(10, 2)
  precoVenda          Decimal? @db.Decimal(10, 2)
  estoqueMinimo       Int?
  observacoes         String?
  criadoEm            DateTime @default(now())
  atualizadoEm        DateTime @updatedAt

  negocio       Negocio                    @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  produto       Produto                    @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  movimentacoes MovimentacaoEstoqueVenda[]
  reservas      ReservaEstoqueVenda[]

  @@unique([produtoId])
  @@index([negocioId])
}

model MovimentacaoEstoqueVenda {
  id                          String   @id @default(cuid())
  estoqueVendaId              String
  tipo                        String
  quantidade                  Int
  unidadeMedida               String
  quantidadeAnterior          Int
  quantidadeNova              Int
  quantidadeReservadaAnterior Int?
  quantidadeReservadaNova     Int?
  motivo                      String?
  referenciaId                String?
  referenciaTipo              String?
  registradoEm                DateTime @default(now())

  estoqueVenda EstoqueVenda @relation(fields: [estoqueVendaId], references: [id], onDelete: Cascade)

  @@index([estoqueVendaId])
  @@index([registradoEm])
  @@index([referenciaId, referenciaTipo])
}

model ReservaEstoqueVenda {
  id             String   @id @default(cuid())
  estoqueVendaId String
  quantidade     Int
  unidadeMedida  String
  status         String   @default("ATIVA")
  referenciaId   String?
  referenciaTipo String?
  observacoes    String?
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  estoqueVenda EstoqueVenda @relation(fields: [estoqueVendaId], references: [id], onDelete: Cascade)

  @@index([estoqueVendaId])
  @@index([referenciaId, referenciaTipo])
}

model EstoqueInterno {
  id                      String   @id @default(cuid())
  negocioId               String
  produtoId               String
  quantidadeAtual         Decimal  @default(0) @db.Decimal(10, 3)
  unidadeMedida           String   @default("UNIDADE")
  custoUnitarioAproximado Decimal? @db.Decimal(10, 2)
  estoqueMinimo           Decimal? @db.Decimal(10, 3)
  observacoes             String?
  criadoEm                DateTime @default(now())
  atualizadoEm            DateTime @updatedAt

  negocio       Negocio                      @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  produto       Produto                      @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  movimentacoes MovimentacaoEstoqueInterno[]

  @@unique([produtoId])
  @@index([negocioId])
}

model MovimentacaoEstoqueInterno {
  id                 String   @id @default(cuid())
  negocioId          String
  estoqueInternoId   String
  produtoId          String
  tipo               String
  quantidade         Decimal  @db.Decimal(10, 3)
  unidadeMedida      String
  quantidadeAnterior Decimal  @db.Decimal(10, 3)
  quantidadeNova     Decimal  @db.Decimal(10, 3)
  motivo             String?
  observacoes        String?
  // Referência operacional da movimentação (ex.: OS e item) — usada como
  // chave de idempotência contra baixa duplicada.
  referenciaId       String?
  referenciaTipo     String?
  referenciaItemId   String?
  registradoEm       DateTime @default(now())

  estoqueInterno EstoqueInterno @relation(fields: [estoqueInternoId], references: [id], onDelete: Cascade)
  negocio        Negocio        @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  produto        Produto        @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([estoqueInternoId])
  @@index([negocioId])
  @@index([produtoId])
  @@index([referenciaTipo, referenciaId])
  @@index([registradoEm])
}

// ============================================================================
// SHARED
// ============================================================================

model Auditoria {
  id         String   @id @default(cuid())
  negocioId  String
  entidade   String
  entidadeId String?
  acao       String
  usuarioId  String?
  dados      Json?
  criadoEm   DateTime @default(now())

  negocio Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([negocioId])
  @@index([entidade, entidadeId])
  @@index([criadoEm])
}

model Anexo {
  id        String   @id @default(cuid())
  negocioId String
  nome      String
  tipo      String?
  mimeType  String?
  url       String
  tamanho   Int?
  criadoEm  DateTime @default(now())

  negocio               Negocio               @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  anexosCliente         AnexoCliente[]
  registrosFotograficos RegistroFotografico[]

  @@index([negocioId])
}

